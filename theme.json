{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "44rem", "wideSize": "68rem" },
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fbf9f5" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1b2a2f" },
				{ "slug": "accent", "name": "Accent", "color": "#0b5d66" },
				{ "slug": "surface", "name": "Surface", "color": "#eef3f1" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.5rem, 1.2rem + 1.2vw, 2rem)" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "40", "name": "Small", "size": "1rem" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(3rem, 8vw, 6rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": { "typography": { "lineHeight": "1.2" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
